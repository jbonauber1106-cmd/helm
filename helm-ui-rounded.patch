diff --git a/src/look_and_feel/ui_style.h b/src/look_and_feel/ui_style.h
new file mode 100644
index 0000000..e819bd5
--- /dev/null
+++ b/src/look_and_feel/ui_style.h
@@ -0,0 +1,17 @@
+/* Shared UI style constants for the rounded-corner look. */
+#pragma once
+#ifndef UI_STYLE_H
+#define UI_STYLE_H
+
+#include <algorithm>
+
+// Corner radius in pixels (at 100% size) for small controls: buttons, selectors, the patch bar.
+// Section containers use twice this. The build script can override this number.
+#define HELM_UI_RADIUS 3.0f
+
+// Radius for a control of the given height; never more than a third of the height.
+inline float helmCorner(float height) {
+  return std::min(HELM_UI_RADIUS, height / 3.0f);
+}
+
+#endif // UI_STYLE_H
