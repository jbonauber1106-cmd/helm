diff --git a/src/editor_sections/rounded_overlay.h b/src/editor_sections/rounded_overlay.h
new file mode 100644
index 0000000..9047cbd
--- /dev/null
+++ b/src/editor_sections/rounded_overlay.h
@@ -0,0 +1,122 @@
+/* Rounds the corners of boxes that are drawn square (OpenGL displays, the keyboard) and trims
+ * anything that pokes outside a rounded section container.
+ *
+ * How it works: Helm draws all static panels into one background image, draws the animated
+ * displays on top of it with OpenGL, and paints ordinary components after that. This overlay is
+ * an ordinary component placed above the sections. For every box it finds, it re-draws the
+ * original background image, clipped to the four tiny corner shapes outside the rounded outline.
+ * That erases the square corners without touching any shaders, and it is only repainted when the
+ * window changes, so it costs nothing per frame.
+ */
+#pragma once
+#ifndef ROUNDED_OVERLAY_H
+#define ROUNDED_OVERLAY_H
+
+#include "JuceHeader.h"
+
+// These must come first: several of the display headers rely on them being declared already.
+#include "synth_slider.h"
+#include "synth_section.h"
+#include "ui_style.h"
+
+#include "filter_response.h"
+#include "graphical_envelope.h"
+#include "graphical_step_sequencer.h"
+#include "midi_keyboard.h"
+#include "open_gl_envelope.h"
+#include "open_gl_oscilloscope.h"
+#include "open_gl_wave_viewer.h"
+#include "oscilloscope.h"
+#include "wave_viewer.h"
+#include "xy_pad.h"
+
+class RoundedCornerOverlay : public Component {
+  public:
+    RoundedCornerOverlay(SynthSection* root, const Image* background) :
+        root_(root), background_(background) {
+      setInterceptsMouseClicks(false, false);
+      setOpaque(false);
+    }
+
+    void paint(Graphics& g) override {
+      if (background_ == nullptr || background_->isNull())
+        return;
+
+      Path corners;
+      collectCorners(root_, corners);
+      if (corners.isEmpty())
+        return;
+
+      g.saveState();
+      g.reduceClipRegion(corners, AffineTransform());
+      g.drawImage(*background_, 0, 0, getWidth(), getHeight(),
+                  0, 0, background_->getWidth(), background_->getHeight());
+      g.restoreState();
+    }
+
+  private:
+    // Radius to use for this component, or 0 if it is not a box we round.
+    float radiusFor(Component* c) const {
+      if (SynthSection* section = dynamic_cast<SynthSection*>(c))
+        return section->drawsContainer() ? section->getContainerRadius() : 0.0f;
+
+      float box_radius = root_->getContainerRadius() * 0.5f;
+      if (dynamic_cast<OpenGLWaveViewer*>(c) || dynamic_cast<OpenGLEnvelope*>(c) ||
+          dynamic_cast<OpenGLOscilloscope*>(c) || dynamic_cast<FilterResponse*>(c) ||
+          dynamic_cast<XYPad*>(c) ||
+          dynamic_cast<GraphicalStepSequencer*>(c) || dynamic_cast<GraphicalEnvelope*>(c) ||
+          dynamic_cast<WaveViewer*>(c) || dynamic_cast<Oscilloscope*>(c) ||
+          dynamic_cast<MidiKeyboard*>(c)) {
+        return box_radius;
+      }
+      return 0.0f;
+    }
+
+    void collectCorners(Component* parent, Path& corners) const {
+      for (int i = 0; i < parent->getNumChildComponents(); ++i) {
+        Component* child = parent->getChildComponent(i);
+        if (child == this || !child->isVisible())
+          continue;
+
+        float radius = radiusFor(child);
+        if (radius > 0.0f)
+          addCorners(corners, getLocalArea(child, child->getLocalBounds()).toFloat(), radius);
+        collectCorners(child, corners);
+      }
+    }
+
+    static void addCorners(Path& path, Rectangle<float> r, float radius) {
+      radius = jmin(radius, r.getWidth() * 0.5f, r.getHeight() * 0.5f);
+      if (radius < 0.5f)
+        return;
+
+      addCorner(path, r.getX(), r.getY(), 1.0f, 1.0f, radius);
+      addCorner(path, r.getRight(), r.getY(), -1.0f, 1.0f, radius);
+      addCorner(path, r.getX(), r.getBottom(), 1.0f, -1.0f, radius);
+      addCorner(path, r.getRight(), r.getBottom(), -1.0f, -1.0f, radius);
+    }
+
+    // The sliver between a square corner (cx, cy) and a quarter circle of the given radius.
+    // dx and dy point from the corner into the box.
+    static void addCorner(Path& path, float cx, float cy, float dx, float dy, float radius) {
+      float c = radius * (1.0f - 0.5523f);
+      path.startNewSubPath(cx, cy);
+      path.lineTo(cx + dx * radius, cy);
+      path.cubicTo(cx + dx * c, cy, cx, cy + dy * c, cx, cy + dy * radius);
+      path.closeSubPath();
+    }
+
+    SynthSection* root_;
+    const Image* background_;
+};
+
+// Drop shadow that follows a rounded outline instead of a square one.
+inline void drawRoundedShadow(Graphics& g, const DropShadow& shadow, Rectangle<int> bounds,
+                              float radius) {
+  Path outline;
+  outline.addRoundedRectangle(float(bounds.getX()), float(bounds.getY()),
+                              float(bounds.getWidth()), float(bounds.getHeight()), radius);
+  shadow.drawForPath(g, outline);
+}
+
+#endif // ROUNDED_OVERLAY_H
